    {
      "company": "路维光电",
      "original_source_id": "fbbfaa667b9e5166472aa329bf48aa53890d3d43c9b1d54958fe8fe9faf6f394",
      "passages": [
        {
          "source_id": "fbbfaa667b9e5166472aa329bf48aa53890d3d43c9b1d54958fe8fe9faf6f394",
          "chunk_id": "c0",
          "text": "深圳市路维光电股份有限公司",
          "spans": [
            {
              "start": 0,
              "end": 13,
              "page": 1,
              "bbox": [
                216.95899963378906,
                92.22200012207031,
                373.55670166015625,
                104.4020004272461
              ],
              "basis": "canonical Unicode code points; [start,end)"
            }
          ],
          "section": "",
          "url": "https://static.cninfo.com.cn/finalpage/2026-04-17/1225113238.PDF",
          "generated_context": null
        },
        {
          "source_id": "fbbfaa667b9e5166472aa329bf48aa53890d3d43c9b1d54958fe8fe9faf6f394",
          "chunk_id": "c1",
          "text": "2025年度“提质增效重回报”行动方案评估报告暨2026年度“提质增效重回报”",
          "spans": [
            {
              "start": 15,
              "end": 54,
              "page": 1,
              "bbox": [
                85.08000183105469,
                115.62200164794922,
                506.7590026855469,
                127.802001953125
              ],
              "basis": "canonical Unicode code points; [start,end)"
            }
          ],
          "section": "",
          "url": "https://static.cninfo.com.cn/finalpage/2026-04-17/1225113238.PDF",
          "generated_context": null
        },
        {
          "source_id": "fbbfaa667b9e5166472aa329bf48aa53890d3d43c9b1d54958fe8fe9faf6f394",
          "chunk_id": "c30",
          "text": "报告期内，公司实现营业收入115,523.17 万元，较上年同期增加31.94%。",
          "spans": [
            {
              "start": 1027,
              "end": 1068,
              "page": 2,
              "bbox": [
                109.08000183105469,
                119.33843994140625,
                505.44000244140625,
                131.33843994140625
              ],
              "basis": "canonical Unicode code points; [start,end)"
            }
          ],
          "section": "",
          "url": "https://static.cninfo.com.cn/finalpage/2026-04-17/1225113238.PDF",
          "generated_context": null
        },
        {
          "source_id": "fbbfaa667b9e5166472aa329bf48aa53890d3d43c9b1d54958fe8fe9faf6f394",
          "chunk_id": "c36",
          "text": "利能力得以加强；报告期内，公司实现归属于上市公司股东的净利润25,198.43",
          "spans": [
            {
              "start": 1265,
              "end": 1304,
              "page": 2,
              "bbox": [
                85.08000183105469,
                259.3784484863281,
                505.44000244140625,
                271.3784484863281
              ],
              "basis": "canonical Unicode code points; [start,end)"
            }
          ],
          "section": "",
          "url": "https://static.cninfo.com.cn/finalpage/2026-04-17/1225113238.PDF",
          "generated_context": null
        },
        {
          "source_id": "fbbfaa667b9e5166472aa329bf48aa53890d3d43c9b1d54958fe8fe9faf6f394",
          "chunk_id": "c43",
          "text": "公司投资建设的路芯半导体掩膜版项目进展顺利，制程节点布局居于国内厂",
          "spans": [
            {
              "start": 1540,
              "end": 1573,
              "page": 2,
              "bbox": [
                109.08000183105469,
                422.8184509277344,
                505.4386291503906,
                434.8184509277344
              ],
              "basis": "canonical Unicode code points; [start,end)"
            }
          ],
          "section": "",
          "url": "https://static.cninfo.com.cn/finalpage/2026-04-17/1225113238.PDF",
          "generated_context": null
        },
        {
          "source_id": "fbbfaa667b9e5166472aa329bf48aa53890d3d43c9b1d54958fe8fe9faf6f394",
          "chunk_id": "c44",
          "text": "商前列。该项目一期产品覆盖130-40nm 制程节点半导体掩膜版，2025 年已逐步",
          "spans": [
            {
              "start": 1575,
              "end": 1617,
              "page": 2,
              "bbox": [
                85.08000183105469,
                446.21844482421875,
                505.4385986328125,
                458.21844482421875
              ],
              "basis": "canonical Unicode code points; [start,end)"
            }
          ],
          "section": "",
          "url": "https://static.cninfo.com.cn/finalpage/2026-04-17/1225113238.PDF",
          "generated_context": null
        },
        {
          "source_id": "fbbfaa667b9e5166472aa329bf48aa53890d3d43c9b1d54958fe8fe9faf6f394",
          "chunk_id": "c45",
          "text": "实现产品量产，实现90nm 及以上成套掩膜版客户端验证通过并供货，40nm 和28nm",
          "spans": [
            {
              "start": 1619,
              "end": 1662,
              "page": 2,
              "bbox": [
                85.08000183105469,
                469.4974365234375,
                505.44000244140625,
                481.4974365234375
              ],
              "basis": "canonical Unicode code points; [start,end)"
            }
          ],
          "section": "",
          "url": "https://static.cninfo.com.cn/finalpage/2026-04-17/1225113238.PDF",
          "generated_context": null
        },
        {
          "source_id": "fbbfaa667b9e5166472aa329bf48aa53890d3d43c9b1d54958fe8fe9faf6f394",
          "chunk_id": "c46",
          "text": "单片掩膜版客户端验证通过并供货，并持续推进40nm 成套掩膜版客户端送样工作；",
          "spans": [
            {
              "start": 1664,
              "end": 1703,
              "page": 2,
              "bbox": [
                85.08000183105469,
                492.7784423828125,
                517.4400024414062,
                504.7784423828125
              ],
              "basis": "canonical Unicode code points; [start,end)"
            }
          ],
          "section": "",
          "url": "https://static.cninfo.com.cn/finalpage/2026-04-17/1225113238.PDF",
          "generated_context": null
        }
      ]
